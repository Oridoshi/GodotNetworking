[configuration]
entry_symbol = "GodoNet_client_library_init"
compatibility_minimum = 4.6

[libraries]
macos.debug.arm64 = "res://bin/macos/arm64/libGodoNet_client.dylib"
macos.release.arm64 = "res://bin/macos/arm64/libGodoNet_client.dylib"
windows.debug.x86_64 = "res://bin/windows/GodoNet_client.dll"
windows.release.x86_64 = "res://bin/windows/GodoNet_client.dll"
linux.debug.x86_64 = "res://bin/linux/libGodoNet_client.so"
linux.release.x86_64 = "res://bin/linux/libGodoNet_client.so"